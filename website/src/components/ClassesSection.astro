---
const classes = [
  {
    name: 'Glioma',
    sub: 'glial tumor',
    color: 'var(--accent)',
    image: '/mri/glioma.png',
    brief: 'Tumor of glial cells — the most common primary brain tumor.',
    detail: 'Arises from the supportive glial tissue. Visually heterogeneous on MRI, often with irregular contrast enhancement.',
  },
  {
    name: 'Meningioma',
    sub: 'meninges tumor',
    color: 'var(--amber)',
    image: '/mri/meningioma.png',
    brief: 'Tumor of the meninges — usually slow-growing.',
    detail: 'Originates in the membranes covering the brain and spinal cord. Typically well-circumscribed extra-axial masses.',
  },
  {
    name: 'No-tumor',
    sub: 'healthy scan',
    color: 'var(--cyan)',
    image: '/mri/notumor.png',
    brief: 'Healthy scan, used as the negative class.',
    detail: 'Normal brain anatomy without pathological mass effect. Acts as the control class to balance the classifier.',
  },
  {
    name: 'Pituitary',
    sub: 'gland tumor',
    color: 'var(--purple)',
    image: '/mri/pituitary.png',
    brief: 'Tumor of the pituitary gland — often adenoma.',
    detail: 'Located in the sella turcica. Small tumor region but well-detected thanks to strong T1 contrast enhancement.',
  },
];
---

<section id="classes" class="classes-section">
  <div class="container">
    <div class="classes-divider" data-animate>
      <span class="divider-line"></span>
      <span class="divider-text font-mono">FOUR TARGET CLASSES</span>
      <span class="divider-line"></span>
    </div>

    <div class="classes-grid" data-animate>
      {classes.map((cls) => (
        <div class="class-card glass">
          <div class="card-image">
            <div class="scan-container">
              <div class="scan-line"></div>
              <img src={cls.image} alt={`${cls.name} MRI scan`} class="mri-img"/>
            </div>
            <div class="image-gradient"></div>
            <div class="card-name-area">
              <div class="card-name" style={`color: ${cls.color}`}>{cls.name}</div>
              <div class="card-sub font-mono">{cls.sub}</div>
            </div>
          </div>
          <div class="card-body">
            <p class="card-brief">{cls.brief}</p>
            <p class="card-detail">{cls.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .classes-section {
    padding: 96px 0 120px;
    position: relative;
  }

  .classes-divider {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: rgba(204, 255, 0, 0.15);
  }

  .divider-text {
    font-size: 11px;
    letter-spacing: 0.15em;
    color: var(--text-muted);
  }

  .classes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 1024px) {
    .classes-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .classes-grid { grid-template-columns: 1fr; }
  }

  .class-card {
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .class-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-border);
  }

  .card-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #000;
  }

  .mri-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.95) contrast(1.1);
    transition: filter var(--transition-base);
  }

  .class-card:hover .mri-img {
    filter: brightness(1.1) contrast(1.2);
  }

  .image-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--bg-elevated) 0%, transparent 60%);
    pointer-events: none;
    z-index: 2;
  }

  .card-name-area {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    z-index: 3;
  }

  .card-name {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .card-sub {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
  }

  .card-body {
    padding: 18px;
    background: var(--bg-elevated);
  }

  .card-brief {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .card-detail {
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid rgba(204, 255, 0, 0.08);
  }
</style>
