---
// Confusion matrix data from notebook output
const matrix = [
  [257, 11, 3, 29],
  [16, 263, 0, 27],
  [6, 3, 395, 1],
  [5, 18, 2, 275],
];
const labels = ['Glioma', 'Meningioma', 'No-tumor', 'Pituitary'];

// Per-class metrics (computed from confusion matrix)
const perClass = [
  { name: 'Glioma', precision: '90.5%', recall: '85.7%', f1: '88.0%', color: 'var(--accent)' },
  { name: 'Meningioma', precision: '89.2%', recall: '86.0%', f1: '87.5%', color: 'var(--amber)' },
  { name: 'No-tumor', precision: '98.8%', recall: '97.5%', f1: '98.1%', color: 'var(--cyan)' },
  { name: 'Pituitary', precision: '82.8%', recall: '91.7%', f1: '87.0%', color: 'var(--purple)' },
];
---

<section id="evaluation">
  <div class="container">
    <div class="section-header" data-animate>
      <div class="section-label">
        <span class="number">06 · EVALUATION</span>
        <span class="line"></span>
        <span class="tag">Performance</span>
      </div>
      <h2 class="section-title text-gradient-coral">Where the model excels — and errs</h2>
      <p class="section-desc">
        The confusion matrix reveals that No-tumor scans are classified almost perfectly, 
        while Glioma and Meningioma show some cross-confusion due to visual similarity.
      </p>
    </div>

    <div class="eval-grid">
      <!-- Confusion Matrix -->
      <div class="matrix-card glass" data-animate>
        <div class="matrix-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          <span>Confusion Matrix (Notebook Plot)</span>
          <span class="font-mono" style="margin-left:auto;font-size:10px;color:var(--text-muted)">911 samples</span>
        </div>

        <div class="matrix-image-wrap">
          <img src="/mri/confusion_matrix.png" alt="Confusion Matrix plot from Notebook" class="matrix-img"/>
        </div>
      </div>

      <!-- Per-class metrics -->
      <div class="metrics-col" data-animate>
        <div class="metrics-title">Per-class Metrics</div>
        {perClass.map(cls => (
          <div class="metric-card glass">
            <div class="metric-header">
              <span class="metric-dot" style={`background:${cls.color}`}></span>
              <span class="metric-name">{cls.name}</span>
            </div>
            <div class="metric-row">
              <div class="metric-item">
                <div class="metric-val" style={`color:${cls.color}`}>{cls.precision}</div>
                <div class="metric-label">Precision</div>
              </div>
              <div class="metric-item">
                <div class="metric-val" style={`color:${cls.color}`}>{cls.recall}</div>
                <div class="metric-label">Recall</div>
              </div>
              <div class="metric-item">
                <div class="metric-val" style={`color:${cls.color}`}>{cls.f1}</div>
                <div class="metric-label">F1-Score</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  section {
    position: relative;
    padding: 96px 0 120px;
  }

  .section-header {
    max-width: 720px;
    margin-bottom: 48px;
  }

  .eval-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 32px;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .eval-grid { grid-template-columns: 1fr; }
  }

  .matrix-card {
    padding: 20px;
    overflow: hidden;
  }

  .matrix-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    font-weight: 600;
    font-size: 14px;
  }

  .matrix-image-wrap {
    width: 100%;
    background: #000;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .matrix-img {
    width: 100%;
    height: auto;
    display: block;
    mix-blend-mode: screen;
    filter: invert(1) hue-rotate(180deg) brightness(0.95);
  }

  .metrics-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .metrics-title {
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 4px;
  }

  .metric-card {
    padding: 16px;
  }

  .metric-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .metric-dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }

  .metric-name {
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .metric-item {
    text-align: center;
  }

  .metric-val {
    font-size: 1.25rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .metric-label {
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 2px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
