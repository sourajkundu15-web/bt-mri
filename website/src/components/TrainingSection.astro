---
---

<section id="training">
  <div class="grid-bg-abs"></div>
  <div class="container">
    <div class="section-header" data-animate>
      <div class="section-label">
        <span class="number">05 · TRAINING</span>
        <span class="line"></span>
        <span class="tag">Optimization</span>
      </div>
      <h2 class="section-title text-gradient-coral">Adam, categorical crossentropy, 100 epochs</h2>
      <p class="section-desc">
        The model trains only the dense head. We track five metrics per epoch — 
        accuracy, loss, precision, recall, and AUC — for both train and validation sets.
      </p>
    </div>

    <!-- Config cards -->
    <div class="config-grid" data-animate>
      <div class="config-card glass">
        <div class="config-icon" style="color:var(--accent)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4M2 12h4m12 0h4m-3.17-6.83l-2.83 2.83m-4 4l-2.83 2.83m0-9.66l2.83 2.83m4 4l2.83 2.83"/></svg>
        </div>
        <div class="config-value">Adam</div>
        <div class="config-label">Optimizer</div>
      </div>
      <div class="config-card glass">
        <div class="config-icon" style="color:var(--amber)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/><path d="m4.93 4.93 14.14 14.14"/></svg>
        </div>
        <div class="config-value">Cat. CE</div>
        <div class="config-label">Loss Function</div>
      </div>
      <div class="config-card glass">
        <div class="config-icon" style="color:var(--cyan)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/></svg>
        </div>
        <div class="config-value">100</div>
        <div class="config-label">Epochs</div>
      </div>
      <div class="config-card glass">
        <div class="config-icon" style="color:var(--purple)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        </div>
        <div class="config-value">100</div>
        <div class="config-label">Batch Size</div>
      </div>
    </div>

    <!-- Notebook charts -->
    <div class="charts-grid" data-animate>
      <div class="chart-card glass">
        <div class="chart-title">
          <span>Model Accuracy & Loss</span>
          <span class="chart-badge font-mono">Notebook Cell 4</span>
        </div>
        <div class="chart-image-wrap">
          <img src="/mri/acc_loss.png" alt="Training Accuracy and Loss curves from Notebook" class="chart-img"/>
        </div>
      </div>
      <div class="chart-card glass">
        <div class="chart-title">
          <span>Precision & Recall Curves</span>
          <span class="chart-badge font-mono">Notebook Cell 4</span>
        </div>
        <div class="chart-image-wrap">
          <img src="/mri/precision_recall.png" alt="Training Precision and Recall curves from Notebook" class="chart-img"/>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    position: relative;
    padding: 96px 0 120px;
  }

  .grid-bg-abs {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(204, 255, 0, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(204, 255, 0, 0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.2;
    pointer-events: none;
  }

  .section-header {
    position: relative;
    max-width: 720px;
    margin-bottom: 48px;
  }

  .config-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 40px;
  }

  @media (max-width: 768px) {
    .config-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .config-card {
    padding: 20px;
    text-align: center;
  }

  .config-icon {
    margin-bottom: 8px;
    display: flex;
    justify-content: center;
  }

  .config-value {
    font-size: 1.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .config-label {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .charts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  @media (max-width: 768px) {
    .charts-grid { grid-template-columns: 1fr; }
  }

  .chart-card {
    padding: 20px;
    overflow: hidden;
  }

  .chart-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    font-weight: 600;
    font-size: 14px;
  }

  .chart-badge {
    font-size: 10px;
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .chart-image-wrap {
    width: 100%;
    background: #000;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .chart-img {
    width: 100%;
    height: auto;
    display: block;
    mix-blend-mode: screen;
    filter: invert(1) hue-rotate(180deg) brightness(0.95);
  }
</style>
