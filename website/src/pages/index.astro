---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import ProblemSection from '../components/ProblemSection.astro';
import DatasetSection from '../components/DatasetSection.astro';
import ClassesSection from '../components/ClassesSection.astro';
import PipelineSection from '../components/PipelineSection.astro';
import ArchitectureSection from '../components/ArchitectureSection.astro';
import TrainingSection from '../components/TrainingSection.astro';
import EpochsSection from '../components/EpochsSection.astro';
import EvaluationSection from '../components/EvaluationSection.astro';
import TechStackSection from '../components/TechStackSection.astro';
import ResultsSection from '../components/ResultsSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main>
    <HeroSection />
    <ProblemSection />
    <DatasetSection />
    <ClassesSection />
    <PipelineSection />
    <ArchitectureSection />
    <TrainingSection />
    <EpochsSection />
    <EvaluationSection />
    <TechStackSection />
    <ResultsSection />
  </main>
  <Footer />
</Layout>
